<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient
                android:startColor="#6C63FF"
                android:endColor="#4A90E2"
                android:angle="45"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#2C2C2C"
                android:endColor="#1F1F1F"
                android:angle="45"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke 
                android:width="1dp" 
                android:color="#444444" />
        </shape>
    </item>
</selector>