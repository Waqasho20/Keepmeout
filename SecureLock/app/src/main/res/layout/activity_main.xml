<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/space_background">

    <!-- Modern Header with Gradient -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:padding="24dp"
        android:elevation="8dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/icon_button_background"
                android:tint="@color/white"
                android:elevation="4dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔐 Waqas Out"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"/>

            <ImageButton
                android:id="@+id/viewSchedulesButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_check"
                android:background="@drawable/icon_button_background"
                android:tint="@color/white"
                android:elevation="4dp"/>
        </LinearLayout>
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Device Lock System"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"/>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Time Period Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@color/card_background"
                android:elevation="8dp"
                android:radius="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_gradient">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏰ Time Period"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="sans-serif-medium"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Start Time -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="START TIME"
                                android:textSize="12sp"
                                android:textColor="@color/primary_accent"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"/>
                            
                            <LinearLayout
                                android:id="@+id/startTimeContainer"
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:background="@drawable/time_button_modern"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:elevation="4dp">

                                <TextView
                                    android:id="@+id/startTimeText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="09:00"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="monospace"/>

                                <TextView
                                    android:id="@+id/startTimeAMPM"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AM"
                                    android:textSize="14sp"
                                    android:textColor="@color/primary_accent"
                                    android:textStyle="bold"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- End Time -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="END TIME"
                                android:textSize="12sp"
                                android:textColor="@color/secondary_accent"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"/>
                            
                            <LinearLayout
                                android:id="@+id/endTimeContainer"
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:background="@drawable/time_button_modern"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:elevation="4dp">

                                <TextView
                                    android:id="@+id/endTimeText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="05:00"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="monospace"/>

                                <TextView
                                    android:id="@+id/endTimeAMPM"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PM"
                                    android:textSize="14sp"
                                    android:textColor="@color/secondary_accent"
                                    android:textStyle="bold"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Days Selection Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@color/card_background"
                android:elevation="8dp"
                android:radius="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_gradient">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📅 Select Days"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="sans-serif-medium"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/daySunday"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="S"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/day_button_modern"
                            android:layout_margin="4dp"
                            android:elevation="4dp"/>

                        <Button
                            android:id="@+id/dayMonday"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="M"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/day_button_modern"
                            android:layout_margin="4dp"
                            android:elevation="4dp"/>

                        <Button
                            android:id="@+id/dayTuesday"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="T"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/day_button_modern"
                            android:layout_margin="4dp"
                            android:elevation="4dp"/>

                        <Button
                            android:id="@+id/dayWednesday"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="W"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/day_button_modern"
                            android:layout_margin="4dp"
                            android:elevation="4dp"/>

                        <Button
                            android:id="@+id/dayThursday"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="R"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/day_button_modern"
                            android:layout_margin="4dp"
                            android:elevation="4dp"/>

                        <Button
                            android:id="@+id/dayFriday"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="F"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/day_button_modern"
                            android:layout_margin="4dp"
                            android:elevation="4dp"/>

                        <Button
                            android:id="@+id/daySaturday"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/day_button_modern"
                            android:layout_margin="4dp"
                            android:elevation="4dp"/>
                    </LinearLayout>
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap days to select/deselect"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:gravity="center"
                        android:fontFamily="sans-serif-light"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Actions Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@color/card_background"
                android:elevation="8dp"
                android:radius="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_gradient">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ Quick Actions"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-medium"/>

                    <Button
                        android:id="@+id/immediateLockButton"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="🚀 IMMEDIATE LOCK"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/action_button_gradient"
                        android:gravity="center"
                        android:layout_marginBottom="12dp"
                        android:elevation="6dp"
                        android:fontFamily="sans-serif-medium"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/testLockButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="🧪 Test Lock"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/secondary_button_modern"
                            android:layout_marginEnd="8dp"
                            android:elevation="4dp"/>

                        <Button
                            android:id="@+id/quickTest30s"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="⚡ 30s Test"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/secondary_button_modern"
                            android:layout_marginStart="8dp"
                            android:elevation="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Label Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@color/card_background"
                android:elevation="8dp"
                android:radius="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_gradient">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏷️ Schedule Label"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-medium"/>

                    <EditText
                        android:id="@+id/labelEditText"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Enter schedule name (e.g., Work Hours, Study Time)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:background="@drawable/edittext_modern"
                        android:padding="16dp"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bottom_gradient"
        android:elevation="8dp">

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="💾 SAVE SCHEDULE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/save_button_gradient"
            android:gravity="center"
            android:elevation="8dp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long press Save for 1-minute test • Long press Test for 30-second test"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"/>

    </LinearLayout>

</LinearLayout> 